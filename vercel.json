{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ico|svg|png|jpg|c|txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/index.html",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(curl|cURL|wget|Wget|HTTPie|httpie).*"
        }
      ],
      "destination": "/api/raw"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(curl|cURL|wget|Wget|HTTPie|httpie).*"
        }
      ],
      "destination": "/api/raw"
    },
    {
      "source": "/all",
      "destination": "/api/raw"
    },
    {
      "source": "/card/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(curl|cURL|wget|Wget|HTTPie|httpie).*"
        }
      ],
      "destination": "/api/raw?id=:id"
    },
    {
      "source": "/:id([1-9])",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(curl|cURL|wget|Wget|HTTPie|httpie).*"
        }
      ],
      "destination": "/api/raw?id=:id"
    },
    {
      "source": "/raw",
      "destination": "/api/raw"
    },
    {
      "source": "/raw/:id",
      "destination": "/api/raw?id=:id"
    },
    {
      "source": "/card/:id.c",
      "destination": "/api/raw?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
